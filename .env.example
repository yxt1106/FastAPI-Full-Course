# Docker Compose development
DATABASE_URL=postgresql+psycopg://bloguser:blogdev123456@db:5432/blog

# Generate your own value for real development
SECRET_KEY=change-me

# S3
S3_BUCKET_NAME=fastapi-blog-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# Application
MAX_UPLOAD_SIZE_BYTES=5242880
POSTS_PER_PAGE=10
RESET_TOKEN_EXPIRE_MINUTES=60

# Mail
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=true

# Frontend
FRONTEND_URL=http://localhost:8000
